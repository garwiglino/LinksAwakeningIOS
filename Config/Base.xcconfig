SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
PRODUCT_NAME = LinksAwakeningDX
PRODUCT_BUNDLE_IDENTIFIER = fr.garwig.linksawakeningdx
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
SWIFT_VERSION = 5.0
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_C_LANGUAGE_STANDARD = c11
HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/Sources/Core" "$(SRCROOT)/Vendor/GBRuntime/include" "$(SRCROOT)/DerivedSources"
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Sources/iOS/BridgingHeader.h
INFOPLIST_FILE = Resources/Info.plist
GENERATE_INFOPLIST_FILE = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_BITCODE = NO
CLANG_WARN_DOCUMENTATION_COMMENTS = NO
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
// Optional machine-local signing settings, ignored by git.
#include? "../LocalConfig.xcconfig"
